PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/eventora
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Leave empty unless you intentionally want secret admin signup.
ADMIN_SIGNUP_SECRET=

# Optional seed admin for first setup. Use a strong password.
ADMIN_SEED_NAME=Eventora Owner
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_PASSWORD=replace-with-a-strong-password
